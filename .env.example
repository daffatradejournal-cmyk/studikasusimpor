# ==============================================================================
# PasarTembilahan — Environment Variables Template (.env.example)
#
# PENTING / DISCLAIMER:
# Aplikasi ini saat ini beroperasi penuh sebagai prototipe studi kasus
# mandiri menggunakan client-side store (React Hook & LocalStorage) dan mock data.
# Variabel di bawah adalah template konfigurasi jika sistem ingin dihubungkan
# ke backend database atau payment gateway produksi nyata.
# ==============================================================================

# 1. Konfigurasi Aplikasi
NEXT_PUBLIC_APP_NAME="PasarTembilahan"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# 2. Database Relasional (Opsional - Jika mengeksekusi schema.sql ke DB fisik)
# Contoh PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/pasartembilahan_db?schema=public"
# Contoh MySQL:
# MYSQL_HOST="localhost"
# MYSQL_PORT=3306
# MYSQL_USER="root"
# MYSQL_PASSWORD=""
# MYSQL_DATABASE="pasartembilahan_db"

# 3. Payment Gateway Midtrans (Opsional - Jika mengaktifkan transaksi nyata)
# Sandbox Environment:
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"
# MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"
# MIDTRANS_IS_PRODUCTION=false
# MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"

# 4. Layanan Logistik / Ekspedisi API (Opsional)
# RAJAONGKIR_API_KEY=""
# RAJAONGKIR_BASE_URL="https://api.rajaongkir.com/starter"
